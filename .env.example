# On Vercel you add these in: Project → Settings → Environment Variables.
# This file is only for local testing with "vercel dev".

# A fixed random string — REQUIRED so logins keep working. Make up a long one.
APP_SECRET=change-this-to-a-long-random-string

# Optional shared password to enter the app (blank = anyone with the link)
ACCESS_CODE=

# ---- AI for the chat replies: "anthropic" or "openai" ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Voice (ElevenLabs). Blank key = text only. ----
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
VOICE_GOKU=
VOICE_BOY=
VOICE_GIRL=

# ---- Vercel KV (storage) ----
# You do NOT set these by hand on Vercel — creating a KV store in the
# dashboard injects them automatically. For local "vercel dev", pull them
# with: vercel env pull .env
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
